.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# 환경설정
.env

# idea/
.idea/
# JavaScript dependencies and generated output (all packages)
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# Environment variants; keep shareable templates
.env.*
!.env.example
!.env.*.example

# Local editor and OS files
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db

# Local Spring overrides (keep shared application.properties tracked)
/backend/src/main/resources/application-local.properties
/backend/src/main/resources/application-local.yml
/backend/src/main/resources/application-local.yaml
/backend/src/main/resources/application-secrets.properties
/backend/src/main/resources/application-secrets.yml
/backend/src/main/resources/application-secrets.yaml

# Private keys and credential stores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
